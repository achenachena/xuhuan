# Local PostgreSQL
POSTGRES_DB=xuhuan
POSTGRES_USER=xuhuan
POSTGRES_PASSWORD=local_xuhuan_password
POSTGRES_PORT=5432

# Redis is non-authoritative and used for rate limiting only.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Go API
DATABASE_URL=postgres://xuhuan:local_xuhuan_password@localhost:5432/xuhuan?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=

# Next.js Mini App
NEXT_PUBLIC_API_URL=http://localhost:8080
