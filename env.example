# Local PostgreSQL
POSTGRES_DB=xuhuan
POSTGRES_USER=xuhuan
POSTGRES_PASSWORD=local_xuhuan_password
POSTGRES_PORT=5432

# Redis is non-authoritative and used for rate limiting only.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_TIMEOUT=150ms
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_IP_REQUESTS=120
RATE_LIMIT_PLAYER_REQUESTS=60
TRUST_PROXY=false

# Go API
APP_ENV=development
APP_VERSION=development
API_PORT=8080
DATABASE_URL=postgres://xuhuan:local_xuhuan_password@localhost:5432/xuhuan?sslmode=disable
# ECS can leave DATABASE_URL unset and inject these split settings from the
# RDS-managed Secrets Manager JSON fields instead:
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=xuhuan
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_SSLMODE=require
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=24h

# Optional OTLP/HTTP export. Leave the endpoint empty for fail-open no-op telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=xuhuan-api
OTEL_EXPORT_INTERVAL=30s

# Explicit local-only authentication. Never enable these settings in production.
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=local-development-token
DEV_TELEGRAM_USER_ID=42424242
DEV_USERNAME=local_player
DEV_FIRST_NAME=Local
DEV_LAST_NAME=Player
DEV_LANGUAGE_CODE=zh-CN

# Next.js Mini App
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEV_AUTH_TOKEN=local-development-token
NEXT_PUBLIC_DEFAULT_LANGUAGE=zh-CN
# Optional external locale override. Bundled Chinese and English are the fallback.
NEXT_PUBLIC_LOCALE_BASE_URL=

# Optional audio URLs. Leave blank to run without hosted audio.
NEXT_PUBLIC_AUDIO_BASE_URL=
NEXT_PUBLIC_AUDIO_BGM=
NEXT_PUBLIC_AUDIO_LIGHT_ATTACK=
NEXT_PUBLIC_AUDIO_HEAVY_ATTACK=
NEXT_PUBLIC_AUDIO_SPECIAL_MOVE=
NEXT_PUBLIC_AUDIO_BLOCK=
NEXT_PUBLIC_AUDIO_DAMAGE=
NEXT_PUBLIC_AUDIO_VICTORY=
NEXT_PUBLIC_AUDIO_DEFEAT=
NEXT_PUBLIC_AUDIO_COMBO=
