{
  "name": "xuhuan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @xuhuan/miniapp",
    "lint": "npm run lint --workspace @xuhuan/miniapp",
    "typecheck": "npm run typecheck --workspace @xuhuan/game-types && npm run typecheck --workspace @xuhuan/miniapp",
    "build": "npm run build --workspace @xuhuan/game-types && npm run build --workspace @xuhuan/miniapp",
    "test": "npm run test --workspace @xuhuan/miniapp",
    "test:e2e": "npm run test:e2e --workspace @xuhuan/miniapp",
    "api:types:check": "npm run check:api-types --workspace @xuhuan/miniapp"
  }
}
