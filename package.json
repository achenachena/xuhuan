{
  "name": "xuhuan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "scripts": {
    "check:content-assets": "node scripts/check-content-assets.mjs",
    "check:english-source": "node scripts/check-english-source.mjs",
    "check:portfolio-demo": "cd apps/api && go run ./cmd/export-portfolio-demo --check ../miniapp/public/game/v4/demo",
    "generate:portfolio-demo": "cd apps/api && go run ./cmd/export-portfolio-demo ../miniapp/public/game/v4/demo",
    "dev": "npm run dev --workspace @xuhuan/miniapp",
    "lint": "npm run lint --workspace @xuhuan/miniapp",
    "typecheck": "npm run typecheck --workspace @xuhuan/miniapp",
    "build": "npm run build --workspace @xuhuan/miniapp",
    "test": "npm run test --workspace @xuhuan/miniapp",
    "test:e2e": "npm run test:e2e --workspace @xuhuan/miniapp"
  }
}
