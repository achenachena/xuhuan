environment              = "production"
aws_region               = "us-east-1"
github_repository        = "achenachena/xuhuan"
github_environment       = "Production"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

cors_allowed_origins = "https://xuhuan-miniapp.vercel.app"

lambda_memory_size          = 512
lambda_timeout              = 30
lambda_reserved_concurrency = 2

# Zero-fixed-cost target. Existing RDS/ElastiCache deployments must follow the
# guarded cutover in README.md before changing these values to false.
managed_data_services_enabled = false
lambda_vpc_enabled             = false

database_instance_class        = "db.t4g.micro"
database_allocated_storage     = 20
database_max_allocated_storage = 0
database_deletion_protection   = true
database_skip_final_snapshot   = false
redis_node_type                = "cache.t4g.micro"
log_retention_days             = 3
alarm_email                    = "owner@example.com"
