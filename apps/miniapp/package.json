{
  "name": "@xuhuan/miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:api-types": "openapi-typescript ../api/openapi/openapi.yaml -o src/lib/api/generated.ts",
    "check:api-types": "node scripts/check-api-types.mjs"
  },
  "dependencies": {
    "@twa-dev/sdk": "^8.0.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@tsconfig/next": "^2.0.6",
    "@types/node": "^20.11.30",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vitest": "4.1.10"
  }
}
